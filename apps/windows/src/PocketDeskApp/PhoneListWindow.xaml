<local:PhonePanel x:Class="PocketDesk.App.PhoneListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PocketDesk.App"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PhoneBackground}" Title="PocketDesk 窗口列表">
  <Viewbox Stretch="Fill">
    <Grid x:Name="DesignRoot" Width="540" Height="595.5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="24,24,24,12">
        <StackPanel>
          <TextBlock Text="窗口" FontFamily="Microsoft YaHei UI" FontSize="30" FontWeight="SemiBold" />
          <TextBlock x:Name="ProfileLabel" Text="Find N5 · 展开模式" FontSize="13" Foreground="#6D6D75" Margin="0,6,0,0" />
        </StackPanel>
        <Button Content="设置" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,10" Click="OnSettingsClick" />
      </Grid>
      <StackPanel Grid.Row="1" Margin="24,0,24,12">
        <Grid x:Name="PlacedActions" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="ReturnButton" Content="返回当前窗口" Padding="10,13" FontSize="16" Click="OnReturnClick" />
          <Button Grid.Column="2" Content="还原到电脑" Padding="10,13" FontSize="16" Click="OnRestoreClick" />
        </Grid>
        <TextBlock x:Name="NoticeLabel" TextWrapping="Wrap" Foreground="#6D6D75" FontSize="14" Margin="0,8,0,0" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly" Padding="24,0,24,0">
        <StackPanel>
          <TextBlock x:Name="EmptyLabel" Text="正在读取窗口…" Foreground="#6D6D75" FontSize="16" Margin="0,18" />
          <ItemsControl x:Name="WindowItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PhoneCardButton}" Click="OnWindowClick" Tag="{Binding}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.AutomationId="{Binding Window.Key}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#007AFF" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="17" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding App}" FontSize="12" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="3" Text="点击窗口铺满 · 还原时保留原位置" Foreground="#6D6D75" FontSize="12"
                 HorizontalAlignment="Center" Margin="12,10,12,16" />
    </Grid>
  </Viewbox>
</local:PhonePanel>
