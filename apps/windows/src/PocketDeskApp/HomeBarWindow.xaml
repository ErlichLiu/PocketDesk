<local:PhonePanel x:Class="PocketDesk.App.HomeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PocketDesk.App"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#172033" Title="PocketDesk 返回栏">
  <Viewbox Stretch="Fill">
    <Grid Width="540" Height="40">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Button Content="≡  窗口列表" Click="OnTap" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="16" />
      <Border Grid.Column="1" Background="#526078" Margin="0,8" />
      <Button Grid.Column="2" Content="↩  还原到电脑" Click="OnRestore" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="16" />
    </Grid>
  </Viewbox>
</local:PhonePanel>
