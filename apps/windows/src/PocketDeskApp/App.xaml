<Application x:Class="PocketDesk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PhoneBackground" Color="#F2F2F7" />
      <SolidColorBrush x:Key="PhoneCard" Color="#FFFFFF" />
      <SolidColorBrush x:Key="PhoneLabel" Color="#1C1C1E" />
      <SolidColorBrush x:Key="PhoneSecondary" Color="#8E8E93" />
      <SolidColorBrush x:Key="PhoneTint" Color="#007AFF" />

      <Style x:Key="PhoneCardButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root"
                      Background="{StaticResource PhoneCard}"
                      CornerRadius="24"
                      Padding="28,22"
                      Margin="0,0,0,18">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
