<Window x:Class="PocketDesk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketDesk 设置" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PhoneBackground}"
        FontFamily="Microsoft YaHei UI">
  <StackPanel Margin="28,24">
    <TextBlock Text="PocketDesk for Windows" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Text="折叠屏远程工作区" FontSize="14" Foreground="#6D6D75" Margin="0,6,0,20" />
    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="ScreenText" FontSize="13" Foreground="#6D6D75" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
    <CheckBox x:Name="EnabledCheck" Content="开启手机工作区（手动常驻）" FontSize="15" Margin="0,0,0,16" Click="OnToggleEnabled" />
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <TextBlock Text="设备形态" FontSize="14" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" x:Name="ProfileCombo" FontSize="14" Padding="8" SelectionChanged="OnProfileChanged" />
    </Grid>
    <TextBlock Text="默认保持应用字号与 UU 原生手势，不改主屏和系统缩放。" TextWrapping="Wrap" FontSize="13" Foreground="#6D6D75" Margin="0,0,0,12" />
    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="13" Foreground="#6D6D75" Margin="0,0,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="打开日志" Padding="14,8" Margin="0,0,10,0" Click="OnOpenLog" />
      <Button Content="还原窗口并退出" Padding="14,8" Click="OnQuit" />
    </StackPanel>
  </StackPanel>
</Window>
